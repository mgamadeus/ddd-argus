{
    "name": "mgamadeus/ddd-argus",
    "description": "External API repository layer for mgamadeus/ddd — batched HTTP calls with multi-tier caching",
    "minimum-stability": "stable",
    "license": "MIT",
    "homepage": "https://github.com/ddd-framework/ddd-argus",
    "support": {
        "issues": "https://github.com/ddd-framework/ddd-argus/issues",
        "source": "https://github.com/ddd-framework/ddd-argus"
    },
    "version": "1.4.0",
    "authors": [
        {
            "name": "Marius-Eugen Gerdan",
            "email": "marius@gerdan.net"
        }
    ],
    "require": {
        "mgamadeus/ddd": "^3.14.3",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "DDD\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DDD\\Tests\\Argus\\": "tests/"
        }
    },
    "extra": {
        "ddd-module": "DDD\\Modules\\Argus\\ArgusModule"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    }
}
